{
  "name": "points-tracker",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A local-only Chrome extension for loyalty point balances and expiration dates.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
